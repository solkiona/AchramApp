<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash screen for Android 12+ -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">#6AB148</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#6AB148</item>
        <item name="android:statusBarColor">#6AB148</item>
        <item name="android:navigationBarColor">#6AB148</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>